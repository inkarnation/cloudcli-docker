# Required (or login interactively with `docker exec -it cloudcli claude login`)
ANTHROPIC_API_KEY=

# UID/GID for the in-container `claude` user. Match the host owner of ./data
# to avoid permission surprises on bind mounts. `id -u` / `id -g` on the host.
PUID=1000
PGID=1000

# Bind address and port for the published port. Default keeps it on loopback;
# put a reverse proxy (Caddy/Traefik/nginx) in front and terminate TLS there.
CLOUDCLI_BIND=127.0.0.1
CLOUDCLI_PORT=3001

# Container timezone.
TZ=Europe/Berlin
